{
  "_about": "Golden cases for the parts of src/shared/geometry.ts that crates/core/src/geometry.rs ports (crop and redact rectangles).",
  "clampNormRect": [
    { "args": [{ "x": 0.1, "y": 0.2, "w": 0.3, "h": 0.4 }], "out": { "x": 0.1, "y": 0.2, "w": 0.3, "h": 0.4 } },
    { "args": [{ "x": -1, "y": 2, "w": 5, "h": 0 }], "out": { "x": 0, "y": 0.98, "w": 1, "h": 0.02 } },
    { "args": [{ "x": 0.5, "y": 0.5, "w": 0.8, "h": 0.8 }], "out": { "x": 0.2, "y": 0.2, "w": 0.8, "h": 0.8 } },
    { "args": [{ "x": 0.99, "y": 0, "w": 0.001, "h": 1 }], "out": { "x": 0.98, "y": 0, "w": 0.02, "h": 1 } }
  ],
  "toPixelRect": [
    { "args": [{ "x": 0.25, "y": 0.25, "w": 0.5, "h": 0.5 }, 640, 360, true], "out": { "x": 160, "y": 90, "w": 320, "h": 180 } },
    { "args": [{ "x": 0.1, "y": 0.1, "w": 0.5, "h": 0.5 }, 1001, 501, true], "out": { "x": 100, "y": 50, "w": 500, "h": 250 } },
    { "args": [{ "x": 0.1, "y": 0.1, "w": 0.5, "h": 0.5 }, 1001, 501, false], "out": { "x": 100, "y": 50, "w": 501, "h": 251 } },
    { "args": [{ "x": 0, "y": 0, "w": 1, "h": 1 }, 1920, 1080, false], "out": { "x": 0, "y": 0, "w": 1920, "h": 1080 } },
    { "args": [{ "x": 0.5, "y": 0.5, "w": 0.5, "h": 0.5 }, 3, 3, true], "out": { "x": 2, "y": 2, "w": 2, "h": 2 } },
    { "args": [{ "x": 0.9, "y": 0.9, "w": 0.5, "h": 0.5 }, 100, 100, false], "out": { "x": 90, "y": 90, "w": 10, "h": 10 } }
  ],
  "isFullRect": [
    { "args": [{ "x": 0, "y": 0, "w": 1, "h": 1 }], "out": true },
    { "args": [{ "x": 0.0005, "y": 0, "w": 0.9995, "h": 1 }], "out": true },
    { "args": [{ "x": 0.1, "y": 0, "w": 0.9, "h": 1 }], "out": false }
  ]
}
